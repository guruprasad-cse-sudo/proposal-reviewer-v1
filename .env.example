# Copy to .env for local development (never commit .env).
DATABASE_URL=postgres://app:app@localhost:5432/reviewer
# DATABASE_SSL=true            # only when connecting to an external database over the internet
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_EMAIL_DOMAINS=dsatm.edu.in     # comma-separated; empty = anyone can register
ADMIN_EMAILS=                          # comma-separated emails that become admins on sign-up
INSTITUTION_NAME=DSATM
APP_NAME=Proposal Reviewer
ANTHROPIC_API_KEY=                     # enables the Claude expert review
CLAUDE_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=15                      # Claude reviews per user per day
PORT=3000
